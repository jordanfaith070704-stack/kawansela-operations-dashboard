# Browser-safe project details. Obtain from Supabase Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=

# Server-only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Per-location Loyverse tokens are encrypted in the server-side connection
# store. Generate with: openssl rand -base64 32. Never expose this key.
POS_CREDENTIAL_ENCRYPTION_KEY=

# Server-to-server endpoints. Never prefix these with NEXT_PUBLIC_.
LOYVERSE_WEBHOOK_SECRET=
CRON_SECRET=
QRIS_PROVIDER=
QRIS_API_KEY=
QRIS_WEBHOOK_SECRET=
